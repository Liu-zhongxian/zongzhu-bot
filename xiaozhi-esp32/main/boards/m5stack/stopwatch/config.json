{
    "manufacturer": "m5stack",
    "type": "m5stack-stopwatch",
    "target": "esp32s3",
    "builds": [
        {
            "name": "m5stack-stopwatch",
            "sdkconfig_append": [
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_USE_AFE_WAKE_WORD=y"
            ]
        },
        {
            "name": "m5stack-stopwatch-zongzhu",
            "sdkconfig_append": [
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_ZONGZHU_EYE_UI=y",
                "CONFIG_USE_DEFAULT_MESSAGE_STYLE=y",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"ni hao zong zhu\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"你好宗主\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_FREERTOS_HZ=1000"
            ]
        }
    ]
}
